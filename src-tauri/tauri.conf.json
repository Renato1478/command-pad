{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Command Pad",
  "version": "0.1.0",
  "identifier": "dev.commandpad.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Command Pad",
        "width": 980,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": { "active": false }
}
